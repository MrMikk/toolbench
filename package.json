{
  "name": "toolbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Client-side mini-apps platform: a single shell hosting independent browser-only tools.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "preact": "^10.26.4",
    "prettier": "^3.4.2",
    "prismjs": "^1.29.0",
    "sql-formatter": "^15.4.9"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^22.13.5",
    "@types/prismjs": "^1.26.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.7"
  },
  "packageManager": "pnpm@9.15.0"
